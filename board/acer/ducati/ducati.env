stdin=vidconsole,usbacm
stdout=vidconsole,usbacm
stderr=vidconsole,usbacm

/*
 * Since commit 78398652723 ("bootm: Tidy up use of autostart env var")
 * bootelf() only executes the payload when "autostart" is explicitly
 * enabled - otherwise the image is loaded and control silently returns
 * to the prompt.
 */
autostart=yes

bootargs=video=efifb nomodeset root=/dev/mmcblk0p2 rootwait rw

linboot=
load mmc 0:1 ${loadaddr} boot/vmlinuz;
bootefi ${loadaddr}

bootcmd=run linboot
